# Copy to .env (git-ignored). Values here override config/*.yaml (see libs/common config loader).
# Profile: local | cloud
CG_PROFILE=local

# Kafka (local kind cluster exposes NodePort 32100 for the bootstrap, see infra/k8s/kafka)
CG_KAFKA__BOOTSTRAP_SERVERS=localhost:32100

# Object storage (MinIO locally; GCS via S3-interoperability HMAC keys in cloud)
CG_STORAGE__ENDPOINT=http://localhost:30900
CG_STORAGE__ACCESS_KEY=cgadmin
CG_STORAGE__SECRET_KEY=cgadmin-change-me

# Postgres (Iceberg JDBC catalog, MLflow, Airflow)
CG_POSTGRES__HOST=localhost
CG_POSTGRES__PORT=30432
CG_POSTGRES__USER=cg
CG_POSTGRES__PASSWORD=cg-change-me

# Serving
CG_MONGO__URI=mongodb://localhost:30017
CG_REDIS__URL=redis://localhost:30379/0

# MLflow
CG_MLFLOW__TRACKING_URI=http://localhost:30500
# Safe placeholders: NEVER commit a real .env file.
# Copy to a private environment store, not repository.
FRAUD_RUN_ID=REPLACE_REAL_RUN_ID
FRAUD_MODEL_URI=hdfs://namenode:8020/fraud/models/REPLACE
FRAUD_MONGO_URI=mongodb://mongo:27017
FRAUD_KAFKA_BOOTSTRAP=kafka:9092
FRAUD_ARCHIVE_CHECKPOINT=hdfs://namenode:8020/fraud/checkpoints/REPLACE/archive
FRAUD_SCORING_CHECKPOINT=hdfs://namenode:8020/fraud/checkpoints/REPLACE/scoring
