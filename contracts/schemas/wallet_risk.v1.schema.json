{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptoguard.local/schemas/wallet_risk.v1.schema.json",
  "title": "WalletRisk v1",
  "description": "Risk of one address, computed in batch by the graph job [R4] (gold.wallet_risk). Exported to Redis (key 'wallet_risk:<address>', JSON value) for the detector [R3] and to MongoDB collection 'wallet_risk' for the API [R5].",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "address", "chain", "risk_score", "taint_score", "label_sources", "as_of_date", "computed_at_ts_us"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "address": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
    "chain": {"type": "string", "enum": ["eth"]},
    "risk_score": {"description": "Final 0..1 score (labels, taint, graph features combined; formula documented in batch/README).", "type": "number", "minimum": 0, "maximum": 1},
    "taint_score": {"description": "USD-weighted taint propagated from bad addresses with decay per hop, 0..1.", "type": "number", "minimum": 0, "maximum": 1},
    "hops_to_nearest_bad": {"type": ["integer", "null"], "minimum": 0},
    "nearest_bad_address": {"type": ["string", "null"], "pattern": "^0x[0-9a-f]{40}$"},
    "nearest_bad_source": {"type": ["string", "null"], "enum": ["ofac", "darklist", "opensanctions", "manual", null]},
    "label_sources": {"description": "Direct labels on this address (empty if none).", "type": "array", "items": {"type": "string"}},
    "is_exchange_wallet": {"type": "boolean"},
    "pagerank": {"type": ["number", "null"]},
    "fan_in": {"type": ["integer", "null"], "minimum": 0},
    "fan_out": {"type": ["integer", "null"], "minimum": 0},
    "total_in_usd": {"type": ["number", "null"]},
    "total_out_usd": {"type": ["number", "null"]},
    "first_seen_ts_us": {"type": ["integer", "null"]},
    "last_seen_ts_us": {"type": ["integer", "null"]},
    "as_of_date": {"description": "Last on-chain date included (YYYY-MM-DD).", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "computed_at_ts_us": {"type": "integer"}
  }
}
