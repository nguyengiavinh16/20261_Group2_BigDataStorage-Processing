# DRAFT W1 - environment variables for the producer / streaming app / API.
# Copy to .env (do NOT commit .env). All addresses come from env; never hard-code them in code.

# --- Kafka ---
# Host (Windows/WSL, Spark local mode):  localhost:9092
# Container on the fraud-net network:    kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=fraud.transactions.v1
KAFKA_TOPIC_DLQ=fraud.transactions.dlq.v1
KAFKA_TOPIC_PREDICTIONS=fraud.predictions.v1
KAFKA_CONSUMER_GROUP_TEST=fraud-consumer-test

# --- Replay (producer, W2) ---
REPLAY_INPUT_PATH=data/processed/transactions.parquet
REPLAY_RATE_EPS=200          # events/second; 0 = as fast as possible
REPLAY_MAX_EVENTS=10000      # 0 = no limit
REPLAY_LOOP=false
SIM_START=2026-01-01T00:00:00Z

# --- Streaming (W4) ---
STREAMING_CHECKPOINT_DIR=checkpoints/scoring
STREAMING_TRIGGER_INTERVAL=5 seconds
STREAMING_WATERMARK=10 minutes
MODEL_PATH=models/baseline_v1
# fraud_score >= ALERT_THRESHOLD -> alert (risk MEDIUM and above); >= RISK_HIGH_THRESHOLD -> HIGH
ALERT_THRESHOLD=0.5          # provisional - finalized by Data & ML Evaluation in W3
RISK_HIGH_THRESHOLD=0.8      # provisional - finalized by Data & ML Evaluation in W3

# --- MongoDB (W5) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=fraud
