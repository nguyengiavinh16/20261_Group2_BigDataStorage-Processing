{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/transaction.schema.json",
  "title": "Transaction",
  "description": "Thông điệp giao dịch thẻ gửi vào Kafka topic 'transactions' (dựa trên dataset Sparkov).",
  "type": "object",
  "required": [
    "trans_num",
    "cc_num",
    "trans_date_trans_time",
    "merchant",
    "category",
    "amt",
    "lat",
    "long",
    "merch_lat",
    "merch_long"
  ],
  "properties": {
    "trans_num": { "type": "string", "minLength": 1, "description": "Mã giao dịch, duy nhất" },
    "cc_num": { "type": "integer", "minimum": 1, "description": "Số thẻ (định danh thẻ, dữ liệu mô phỏng)" },
    "trans_date_trans_time": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
      "description": "Thời điểm giao dịch, định dạng YYYY-MM-DD HH:MM:SS"
    },
    "unix_time": { "type": "integer", "minimum": 0 },
    "merchant": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "amt": { "type": "number", "exclusiveMinimum": 0, "description": "Số tiền giao dịch (> 0)" },
    "gender": { "type": "string", "enum": ["M", "F"] },
    "city": { "type": "string" },
    "state": { "type": "string" },
    "zip": { "type": "string" },
    "city_pop": { "type": "integer", "minimum": 0 },
    "job": { "type": "string" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "long": { "type": "number", "minimum": -180, "maximum": 180 },
    "merch_lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "merch_long": { "type": "number", "minimum": -180, "maximum": 180 },
    "is_fraud": {
      "type": "integer",
      "enum": [0, 1],
      "description": "Nhãn thật, chỉ dùng khi replay để đánh giá; mô hình KHÔNG được dùng làm feature"
    }
  },
  "additionalProperties": false
}
